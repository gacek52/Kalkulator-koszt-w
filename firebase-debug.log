[debug] [2025-10-22T13:38:13.616Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kalkulator-produkcyjny---alpha/rulesets {"name":"projects/kalkulator-produkcyjny---alpha/rulesets/eb1b51b2-bdd3-4037-b850-dacdafa3dee2","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // Helper functions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isAuthenticated() && (\r\n        request.auth.token.email == 'gacek52@gmail.com' ||\r\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'\r\n      );\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuthenticated() &&\r\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\r\n    }\r\n\r\n    function isAdminOrSuper() {\r\n      return isAdmin() || isSuperAdmin();\r\n    }\r\n\r\n    // Sprawdź czy użytkownik ma konkretne uprawnienie w swojej roli\r\n    function hasPermission(permission) {\r\n      return isAuthenticated() && (\r\n        request.auth.token.email == 'gacek52@gmail.com' ||\r\n        get(/databases/$(database)/documents/roles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)).data.permissions[permission] == true\r\n      );\r\n    }\r\n\r\n    // Users collection\r\n    match /users/{userId} {\r\n      allow read: if hasPermission('users_view');\r\n      allow create: if hasPermission('users_create') || isOwner(userId);\r\n      allow update: if isOwner(userId) || hasPermission('users_edit');\r\n      allow delete: if hasPermission('users_delete');\r\n    }\r\n\r\n    // Roles collection - zarządzanie rolami\r\n    match /roles/{roleId} {\r\n      allow read: if isAuthenticated(); // Wszyscy mogą czytać role (potrzebne do hasPermission())\r\n      allow create, update, delete: if hasPermission('roles_manage');\r\n    }\r\n\r\n    // Catalog collection (metadata kalkulacji)\r\n    match /catalog/{calculationId} {\r\n      allow read: if hasPermission('catalog_view_all') ||\r\n                    (hasPermission('catalog_view_own') && resource.data.ownerId == request.auth.uid);\r\n      allow create: if hasPermission('catalog_edit_own');\r\n      allow update: if hasPermission('catalog_edit_all') ||\r\n                      (hasPermission('catalog_edit_own') && resource.data.ownerId == request.auth.uid) ||\r\n                      resource.data.sharedAccess == true;\r\n      allow delete: if hasPermission('catalog_edit_all') ||\r\n                      (hasPermission('catalog_edit_own') && resource.data.ownerId == request.auth.uid);\r\n    }\r\n\r\n    // Calculations collection (pełne dane kalkulacji)\r\n    match /calculations/{calculationId} {\r\n      allow read: if hasPermission('calculations_view_all') ||\r\n                    (hasPermission('calculations_view_own') &&\r\n                     get(/databases/$(database)/documents/catalog/$(calculationId)).data.ownerId == request.auth.uid);\r\n      allow create: if hasPermission('calculations_edit_own');\r\n      allow update: if hasPermission('calculations_edit_all') ||\r\n                      (hasPermission('calculations_edit_own') &&\r\n                       get(/databases/$(database)/documents/catalog/$(calculationId)).data.ownerId == request.auth.uid) ||\r\n                      get(/databases/$(database)/documents/catalog/$(calculationId)).data.sharedAccess == true;\r\n      allow delete: if hasPermission('calculations_delete_all') ||\r\n                      (hasPermission('calculations_delete_own') &&\r\n                       get(/databases/$(database)/documents/catalog/$(calculationId)).data.ownerId == request.auth.uid);\r\n    }\r\n\r\n    // Clients collection\r\n    match /clients/{clientId} {\r\n      allow read: if hasPermission('clients_view_all') ||\r\n                    (hasPermission('clients_view_own') && resource.data.ownerId == request.auth.uid);\r\n      allow create: if hasPermission('clients_edit_own');\r\n      allow update: if hasPermission('clients_edit_all') ||\r\n                      (hasPermission('clients_edit_own') && resource.data.ownerId == request.auth.uid);\r\n      allow delete: if hasPermission('clients_delete');\r\n    }\r\n\r\n    // Materials collection\r\n    match /materials/{materialId} {\r\n      allow read: if hasPermission('materials_view');\r\n      allow create, update: if hasPermission('materials_edit');\r\n      allow delete: if hasPermission('materials_edit');\r\n    }\r\n\r\n    // Packaging collection\r\n    match /packaging/{packagingId} {\r\n      allow read: if hasPermission('packaging_view');\r\n      allow create, update: if hasPermission('packaging_edit');\r\n      allow delete: if hasPermission('packaging_edit');\r\n    }\r\n\r\n    // Client Manual collection\r\n    match /client-manual/{manualId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if hasPermission('settings_edit');\r\n    }\r\n\r\n    // Workstations collection - globalne stanowiska produkcyjne\r\n    match /workstations/{workstationId} {\r\n      allow read: if hasPermission('workstations_view');\r\n      allow create, update, delete: if hasPermission('workstations_edit');\r\n    }\r\n\r\n    // Sessions collection - każdy użytkownik ma dostęp tylko do swojej sesji\r\n    match /sessions/{userId} {\r\n      allow read, write: if isOwner(userId);\r\n    }\r\n\r\n    // WorkstationAssignments collection - przypisania stanowisk do elementów kalkulacji\r\n    // Używane przez dashboard capacity do obliczenia zajętości stanowisk\r\n    match /workstationAssignments/{assignmentId} {\r\n      allow read: if isAuthenticated(); // Wszyscy mogą czytać (dashboard)\r\n      allow write: if isAuthenticated(); // Wszyscy mogą zapisywać swoje przypisania\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2025-10-22T13:38:13.259951Z","metadata":{"services":["cloud.firestore"]}}

[debug] [2025-10-22T07:32:37.320Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kalkulator-produkcyjny---alpha/rulesets {"name":"projects/kalkulator-produkcyjny---alpha/rulesets/92d05670-092e-4741-90be-dff57e5dbf1e","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // Helper functions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isAuthenticated() && (\r\n        request.auth.token.email == 'gacek52@gmail.com' ||\r\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'\r\n      );\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isAuthenticated() &&\r\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\r\n    }\r\n\r\n    function isAdminOrSuper() {\r\n      return isAdmin() || isSuperAdmin();\r\n    }\r\n\r\n    // Users collection\r\n    match /users/{userId} {\r\n      allow read: if isAuthenticated();\r\n      // Użytkownik może edytować swój profil LUB admin/super-admin może edytować innych\r\n      allow create: if isSuperAdmin(); // Tylko super-admin może tworzyć nowych użytkowników\r\n      allow update: if isOwner(userId) || isAdminOrSuper();\r\n      allow delete: if isSuperAdmin(); // Tylko super-admin może usuwać użytkowników\r\n    }\r\n\r\n    // Roles collection - zarządzanie rolami\r\n    match /roles/{roleId} {\r\n      allow read: if isAuthenticated(); // Wszyscy mogą czytać role\r\n      allow create, update, delete: if isSuperAdmin(); // Tylko super-admin może zarządzać rolami\r\n    }\r\n\r\n    // Catalog collection (metadata kalkulacji)\r\n    match /catalog/{calculationId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() &&\r\n                             (resource.data.ownerId == request.auth.uid ||\r\n                              resource.data.sharedAccess == true ||\r\n                              isAdmin());\r\n    }\r\n\r\n    // Calculations collection (pełne dane kalkulacji)\r\n    match /calculations/{calculationId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n      allow update, delete: if isAuthenticated() &&\r\n                             (get(/databases/$(database)/documents/catalog/$(calculationId)).data.ownerId == request.auth.uid ||\r\n                              get(/databases/$(database)/documents/catalog/$(calculationId)).data.sharedAccess == true ||\r\n                              isAdmin());\r\n    }\r\n\r\n    // Clients collection\r\n    match /clients/{clientId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated(); // Wszyscy zalogowani mogą zarządzać klientami\r\n    }\r\n\r\n    // Materials collection\r\n    match /materials/{materialId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated(); // Wszyscy zalogowani mogą zarządzać materiałami\r\n    }\r\n\r\n    // Packaging collection\r\n    match /packaging/{packagingId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated(); // Wszyscy zalogowani mogą zarządzać opakowaniami\r\n    }\r\n\r\n    // Client Manual collection\r\n    match /client-manual/{manualId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAdmin(); // Tylko admini mogą modyfikować instrukcje\r\n    }\r\n\r\n    // Workstations collection - globalne stanowiska produkcyjne\r\n    match /workstations/{workstationId} {\r\n      allow read: if isAuthenticated(); // Wszyscy zalogowani mogą czytać\r\n      allow write: if isAdmin(); // Tylko admini mogą modyfikować stanowiska\r\n    }\r\n\r\n    // Sessions collection - każdy użytkownik ma dostęp tylko do swojej sesji\r\n    match /sessions/{userId} {\r\n      allow read, write: if isOwner(userId);\r\n    }\r\n\r\n    // WorkstationAssignments collection - przypisania stanowisk do elementów kalkulacji\r\n    // Używane przez dashboard capacity do obliczenia zajętości stanowisk\r\n    match /workstationAssignments/{assignmentId} {\r\n      allow read: if isAuthenticated(); // Wszyscy mogą czytać (dashboard)\r\n      allow write: if isAuthenticated(); // Wszyscy mogą zapisywać swoje przypisania\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2025-10-22T07:32:37.173151Z","metadata":{"services":["cloud.firestore"]}}
